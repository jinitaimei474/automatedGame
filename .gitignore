# Keep dataset structure, metadata and YOLO text labels in Git, but not source
# videos/screenshots or rendered previews. These local assets are about 1.8 GB.
automation/training/clash_royale/datasets/raw/
automation/training/clash_royale/datasets/prelabels_gpt56sol/images/
automation/training/clash_royale/datasets/prelabels_gpt56sol/previews/
automation/training/clash_royale/datasets/images/*/*
automation/training/clash_royale/datasets/labels/*/*
!.gitkeep
